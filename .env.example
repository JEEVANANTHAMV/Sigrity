# Copy to .env and adjust if your Sigrity install differs from the default.
SIGRITY_HOME=C:\Cadence\Sigrity2024.0
SIGRITY_WORKDIR=runs
SIGRITY_DEFAULT_TIMEOUT_SECONDS=1800

# Corporate proxy (only needed for pip/uv installs and WebSearch-based research, not for
# talking to Sigrity itself, which is entirely local). Fill in YOUR proxy; leave unset if
# you have direct outbound access.
# HTTP_PROXY=http://<your-proxy-host>:<port>
# HTTPS_PROXY=http://<your-proxy-host>:<port>

# Local OpenAI-compatible model used for end-to-end MCP tool-calling tests
# (only read by scripts/test_llm_e2e.py). Leave unset if you don't run that test.
# TEST_LLM_BASE_URL=http://127.0.0.1:8000/v1
# TEST_LLM_MODEL=qwen3-max
